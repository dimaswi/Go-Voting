# ========================
# Application
# ========================
APP_ENV=development
APP_PORT=8080
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# ========================
# Database
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=govote
DB_PASSWORD=govote_dev_password
DB_NAME=Go-Vote
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# ========================
# JWT
# ========================
JWT_SECRET=change-this-jwt-secret-key-in-production
JWT_EXPIRY_HOURS=24

# ========================
# Upload
# ========================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ========================
# Frontend URL (for CORS)
# ========================
FRONTEND_URL=http://localhost:5173

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
